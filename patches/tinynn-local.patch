+def slice_per_channel_quantization(tensor: tfl.Tensor, num_chunks: int, chunk_idx: int):
+    # When a tensor is split along the quantized dimension (e.g. group conv rewrite),
+    # per-channel scales/zero-points must be split accordingly.
+    quantization = tensor.quantization
+    if quantization is None:
+        return None
+    scale = np.atleast_1d(np.asarray(quantization.scale))
+    if scale.size <= 1 or scale.size % num_chunks != 0:
+        return quantization
+    new_scale = np.split(scale, num_chunks)[chunk_idx].tolist()
+    zero_point = np.atleast_1d(np.asarray(quantization.zero_point))
+    if zero_point.size == scale.size:
+        new_zero_point = np.split(zero_point, num_chunks)[chunk_idx].tolist()
+    else:
+        new_zero_point = quantization.zero_point
+    return tfl.QuantizationParameters(new_scale, new_zero_point, quantization.dim)
+
+
